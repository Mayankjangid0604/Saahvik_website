{
  // Cloudflare Pages configuration.
  // `pages_build_output_dir` is what Pages reads (Workers uses `assets`
  // instead). With this set, `wrangler pages deploy` uploads ./out directly —
  // no framework wizard, no OpenNext.
  "name": "saahvikwebsite",
  "compatibility_date": "2026-06-30",
  "pages_build_output_dir": "./out"
}
